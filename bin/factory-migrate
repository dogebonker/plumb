#!/usr/bin/env python3
"""Move a repository's factory state from .factory/ to .software-factory/ on the current branch.

    bin/factory-migrate [--dry-run] [<repo>]

.factory/system and .factory/changes keep their names; .factory/{ci,ui,security,prune}
go under .software-factory/runs/. A folder with tracked files moves with git mv,
which carries its untracked files along; any other folder moves with a plain rename.
Lines of .git/info/exclude that name .factory are rewritten the same way. Nothing is
committed. It also lists the other local and remote branches whose tree still has
.factory/, and the local ones it skipped because another worktree has them checked out.
"""
import argparse
import re
import subprocess
import sys
from pathlib import Path

OLD, NEW = ".factory", ".software-factory"
MAP = {"system": "system", "changes": "changes",
       "ci": "runs/ci", "ui": "runs/ui", "security": "runs/security", "prune": "runs/prune"}
IN_PROGRESS = ("rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD")
EXCLUDE_LINE = re.compile(r"^(!?(?:/|\*\*/)?)\.factory(/.*)?\s*$")


def git(repo, *args, may_fail=False):
    r = subprocess.run(["git", "--no-optional-locks", "-C", str(repo), *args], capture_output=True, text=True, check=False)
    if r.returncode and may_fail:
        return ""
    if r.returncode:
        sys.exit(f"factory-migrate: git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout


def new_path(path):
    """The .software-factory path for a path that is .factory or starts with .factory/."""
    first, slash, rest = path[len(OLD) + 1:].partition("/")
    if first not in MAP:
        return NEW + path[len(OLD):]
    return f"{NEW}/{MAP[first]}{slash}{rest}"


def has_factory_tree(root, ref):
    """True when ref's tree has a .factory folder (not a file of that name)."""
    return git(root, "ls-tree", ref, "--", OLD).split()[1:2] == ["tree"]


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("repo", nargs="?", default=".")
    args = parser.parse_args()
    root = Path(git(args.repo, "rev-parse", "--show-toplevel").strip())
    old = root / OLD
    if old.is_symlink():
        sys.exit(f"factory-migrate: refused: {OLD} is a symlink to {old.resolve()}; move its content in by hand first")

    moves, left = [], []
    if old.is_dir():
        for entry in sorted(old.iterdir()):
            if entry.name in MAP and entry.is_dir():
                tracked = bool(git(root, "ls-files", "--", f"{OLD}/{entry.name}").strip())
                moves.append((f"{OLD}/{entry.name}", f"{NEW}/{MAP[entry.name]}", tracked))
            else:
                left.append(f"{OLD}/{entry.name}")

    refusals = []
    for name in IN_PROGRESS:
        if moves and Path(git(root, "rev-parse", "--path-format=absolute", "--git-path", name).strip()).exists():
            refusals.append(f"a {name} is in progress; finish or abort it first")
    status = git(root, "status", "--porcelain", "--untracked-files=no").splitlines()
    dirty = [line[3:] for line in status if not line[3:].strip('"').startswith(OLD + "/")]
    if moves and dirty:
        refusals.append("tracked changes outside .factory/: " + ", ".join(dirty) + "; commit or stash them first")
    broken = [line[3:] for line in status if line[3:].strip('"').startswith(OLD + "/")
              and ("D" in line[:2] or "U" in line[:2] or line[:2] == "AA")]
    if broken:
        refusals.append("deleted or unmerged files under .factory/: " + ", ".join(broken) + "; restore or commit them first")
    for src, dst, _ in moves:
        if (root / dst).exists():
            refusals.append(f"{dst} already exists; {src} would land inside it")
    if not refusals:
        for src, dst, tracked in moves:
            check = tracked and subprocess.run(["git", "-C", str(root), "mv", "-n", src, dst], capture_output=True, text=True)
            if check and check.returncode:
                refusals.append(f"git mv {src} {dst} would fail: {check.stderr.strip()}")

    exclude = Path(git(root, "rev-parse", "--path-format=absolute", "--git-path", "info/exclude").strip())
    lines = exclude.read_text().splitlines(keepends=True) if exclude.is_file() else []
    rewritten = []
    for line in lines:
        m = EXCLUDE_LINE.match(line.rstrip("\n").rstrip("\r"))
        target = m and m.group(1) + new_path(OLD + (m.group(2) or "").rstrip())
        rewritten.append(target + ("\n" if line.endswith("\n") else "") if target else line)

    current = git(root, "symbolic-ref", "--quiet", "--short", "HEAD", may_fail=True).strip()
    elsewhere = {line.split(" ", 1)[1].removeprefix("refs/heads/")
                 for line in git(root, "worktree", "list", "--porcelain").splitlines() if line.startswith("branch ")}
    local = [b for b in git(root, "for-each-ref", "--format=%(refname:short)", "refs/heads").split()
             if b != current and has_factory_tree(root, b)]
    remote = [r.split()[0] for r in git(root, "for-each-ref", "--format=%(refname:short) %(symref)", "refs/remotes").splitlines()
              if len(r.split()) == 1 and has_factory_tree(root, r.split()[0])]

    if refusals:
        for reason in refusals:
            print(f"factory-migrate: refused: {reason}", file=sys.stderr)
        sys.exit(1)

    verb = "would " if args.dry_run else ""
    if not moves:
        print(f"nothing to migrate on {current or 'this checkout'}: no {OLD}/ folder the mapping covers")
    for src, dst, tracked in moves:
        print(f"{verb}{'git mv' if tracked else 'mv'} {src} {dst}")
    for path in left:
        print(f"{verb}leave {path}: the mapping does not cover it")
    for before, after in zip(lines, rewritten):
        if before != after:
            print(f"{verb}rewrite {exclude}: {before.rstrip()} -> {after.rstrip()}")
    for name in git(root, "grep", "-lF", OLD, "--", "*.gitignore", may_fail=True).split():
        print(f"note: {name} still names {OLD}; edit it by hand")
    for symlink in sorted(p for p in old.rglob("*") if p.is_symlink()) if old.is_dir() else []:
        print(f"warning: {symlink.relative_to(root)} is a symlink; it moves as a link, its target stays")
    print("other local branches with .factory/: " + (" ".join(b for b in local if b not in elsewhere) or "none"))
    skipped = [b for b in local if b in elsewhere]
    if skipped:
        print("skipped, checked out in another worktree: " + " ".join(skipped))
    print("remote branches with .factory/: " + (" ".join(remote) or "none"))

    if args.dry_run:
        print("dry run: nothing changed")
        return
    for src, dst, tracked in moves:
        (root / dst).parent.mkdir(parents=True, exist_ok=True)
        if tracked:
            git(root, "mv", src, dst)
        else:
            (root / src).rename(root / dst)
    if old.is_dir() and not any(old.iterdir()):
        old.rmdir()
    if rewritten != lines:
        exclude.write_text("".join(rewritten))


if __name__ == "__main__":
    main()
