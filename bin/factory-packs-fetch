#!/usr/bin/env python3
"""Fetch pinned packs into the pack cache: ~/.software-factory/packs/<name>@<hash>/.

    bin/factory-packs-fetch [<repo> | <lock file>]

Reads the `packs:` block of <repo>/.software-factory/factory.lock (<repo> defaults to the
current directory), or of a lock file named directly, such as the framework's kit/packs.lock.yaml.
Each source has a bare mirror, ~/.software-factory/packs/.mirrors/<owner>__<repo>.git, cloned
from https://github.com/<source>.git without blobs and fetched only when a pin's hash is missing
from it, so pins already in a mirror load offline. A pin's hash names the tree of the pack's
folder in its source, or a commit, whose root tree is the pack (how the skills CLI recorded a
pack at a repository's root; such a pin's path must be `.`). That tree is unpacked with git
archive into a temporary folder, with every attribute that rewrites content switched off and no
global or system git config, its tree hash is recomputed from the files and must equal the pin,
symlinks must stay inside the pack, and the folder is renamed into place: a cache folder is
complete or absent, and one that exists is left alone. Prints one line per pin: present,
fetched or failed, and exits 1 on any failure.
"""
import fcntl
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

NAME = re.compile(r"[a-z0-9-]+")
HASH = re.compile(r"[0-9a-f]{40}")
SOURCE = re.compile(r"[A-Za-z0-9-]+/(?!\.\.?$)[A-Za-z0-9._-]+")
ENTRY = re.compile(r"\s+([^\s:#]+):\s*\{([^{}]*)\}\s*(#.*)?")
GIT_TIMEOUT = 300
GIT_ENV = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}  # a missing or private source fails instead of asking
# Network calls: packs are public, so no credential helper, and no ssh prompt when the user's config rewrites GitHub to ssh.
NET = ("-c", "credential.helper=", "-c", "transfer.fsckObjects=true")
NET_ENV = {**GIT_ENV, "GIT_SSH_COMMAND": "ssh -o BatchMode=yes"}
# Local calls: never the network, and no global or system config (autocrlf, filter drivers) between the tree and the files.
LOCAL_ENV = {**GIT_ENV, "GIT_NO_LAZY_FETCH": "1", "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"}
ATTRIBUTES = "* -text -eol -crlf -filter -ident -export-ignore -export-subst -working-tree-encoding\n"


class Failed(Exception):
    pass


def label(args):
    """The git subcommand, past any -c options."""
    return next(a for a in args if not a.startswith("-") and "=" not in a)


def git(git_dir, *args, stdin=None, binary=False, env=LOCAL_ENV):
    cmd = ["git", *(["--git-dir", str(git_dir)] if git_dir else []), *args]
    try:
        r = subprocess.run(cmd, input=stdin, capture_output=True, text=not binary, check=False, env=env,
                           timeout=GIT_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise Failed(f"git {label(args)} timed out after {GIT_TIMEOUT} s")
    if r.returncode:
        err = r.stderr.decode(errors="replace") if binary else r.stderr
        raise Failed(f"git {label(args)}: {(err.strip().splitlines() or ['failed'])[-1]}")
    return r.stdout if binary else r.stdout.strip()


def network(source, broken, git_dir, *args, stdin=None):
    """A git call that reaches the source; after one failure, the source's later calls fail without trying."""
    if source in broken:
        raise Failed(broken[source])
    try:
        return git(git_dir, *NET, *args, stdin=stdin, env=NET_ENV)
    except Failed as e:
        broken[source] = str(e)
        raise


def pins(lock):
    """{name: {key: value}} from the block of one-line flow maps under `packs:`; exits on anything else."""
    found, inside, blocks = {}, False, 0
    for number, line in enumerate(lock.read_text().splitlines(), 1):
        if re.match(r"^packs\s*:", line):
            blocks += 1
            if blocks > 1:
                sys.exit(f"factory-packs-fetch: {lock}:{number}: a second packs: block")
            if not re.fullmatch(r"packs:\s*(\{\})?\s*(#.*)?", line):
                sys.exit(f"factory-packs-fetch: {lock}:{number}: write packs as a block, one indented "
                         "`<name>: { source: ..., path: ..., hash: ..., pinned_at: ... }` line per pack")
            inside = True
        elif inside and re.match(r"^\S", line):
            inside = False
        elif inside and line.strip() and not line.lstrip().startswith("#"):
            m = ENTRY.fullmatch(line)
            if not m:
                sys.exit(f"factory-packs-fetch: {lock}:{number}: not a pack entry: {line.strip()}")
            if m.group(1) in found:
                sys.exit(f"factory-packs-fetch: {lock}:{number}: pack {m.group(1)} pinned twice")
            found[m.group(1)] = dict(re.findall(r"(\w+):\s*[\"']?([^,\"'}\s]+)", m.group(2)))
    return found


def object_type(mirror, sha):
    try:
        return git(mirror, "cat-file", "-t", sha)
    except Failed:
        return None


def mirror_for(packs, source, fetched, broken):
    """The source's bare mirror, cloned when missing (the clone counts as this run's fetch); its origin and
    attributes are reset on every use."""
    mirror = packs / ".mirrors" / f"{source.replace('/', '__')}.git"
    url = f"https://github.com/{source}.git"
    if not mirror.is_dir():
        mirror.parent.mkdir(exist_ok=True)
        tmp = Path(tempfile.mkdtemp(prefix=".tmp-", dir=packs))
        try:
            network(source, broken, None, "clone", "--quiet", "--bare", "--filter=blob:none", url, str(tmp / "m.git"))
            git(tmp / "m.git", "config", "remote.origin.fetch", "+refs/heads/*:refs/heads/*")
            (tmp / "m.git").rename(mirror)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        fetched.add(source)
    git(mirror, "config", "remote.origin.url", url)
    (mirror / "info").mkdir(exist_ok=True)
    (mirror / "info" / "attributes").write_text(ATTRIBUTES)  # outranks the pack's own .gitattributes
    return mirror


def escaping_links(mirror, tree, root):
    """Symlinks in the unpacked tree whose target is absolute or resolves outside root."""
    root = root.resolve()
    bad = []
    for entry in git(mirror, "ls-tree", "-r", "-z", tree).split("\0"):
        if entry.startswith("120000 "):
            path = entry.split("\t", 1)[1]
            target = os.readlink(root / path)
            try:
                inside = (root / path).resolve().is_relative_to(root)
            except (OSError, RuntimeError):  # a link loop
                inside = False
            if os.path.isabs(target) or not inside:
                bad.append(f"{path} -> {target}")
    return bad


def fetch_pin(packs, name, pin, fetched, broken):
    """Returns "present" or "fetched"; raises Failed with the reason."""
    source, sha = pin.get("source", ""), pin.get("hash", "")
    if not NAME.fullmatch(name):
        raise Failed("refused: the name must match [a-z0-9-]+")
    if not HASH.fullmatch(sha):
        raise Failed("refused: hash must be 40 lowercase hex characters")
    if not SOURCE.fullmatch(source):
        raise Failed(f"refused: source {source!r} is not owner/repo")
    target = packs / f"{name}@{sha}"
    if target.is_dir():
        return "present"
    mirror = mirror_for(packs, source, fetched, broken)
    kind = object_type(mirror, sha)
    if kind is None and source not in fetched:
        network(source, broken, mirror, "fetch", "--quiet", "origin")
        fetched.add(source)
        kind = object_type(mirror, sha)
    if kind is None:
        raise Failed(f"{sha} not found in {source}")
    if kind == "commit" and pin.get("path", ".") != ".":
        raise Failed(f"refused: {sha} is a commit, which pins a repository's root, but path is {pin['path']!r}")
    if kind not in ("tree", "commit"):
        raise Failed(f"{sha} names a {kind} in {source}, not a tree")
    tree = git(mirror, "rev-parse", f"{sha}^{{tree}}")
    missing = re.findall(r"^\?(\S+)", git(mirror, "rev-list", "--objects", "--missing=print", tree), re.MULTILINE)
    if missing:  # one batched fetch of the tree's blobs, instead of one lazy fetch per file
        network(source, broken, mirror, "-c", "fetch.negotiationAlgorithm=noop", "fetch", "--quiet", "--no-tags",
                "--no-write-fetch-head", "--recurse-submodules=no", "--filter=blob:none", "--stdin", "origin",
                stdin="\n".join(missing) + "\n")
    tmp = Path(tempfile.mkdtemp(prefix=".tmp-", dir=packs))
    try:
        (tmp / "tree").mkdir()
        subprocess.run(["tar", "-x", "-C", str(tmp / "tree")], input=git(mirror, "archive", "--format=tar", tree, binary=True),
                       check=True)
        index = {**LOCAL_ENV, "GIT_INDEX_FILE": str(tmp / "index"), "GIT_WORK_TREE": str(tmp / "tree")}
        git(mirror, "-c", "core.autocrlf=false", "add", "-A", "-f", ":/", env=index)
        got = git(mirror, "write-tree", env=index)
        if got != tree:  # a damaged mirror, or a git that ignored the attributes above
            raise Failed(f"the unpacked files hash to {got}, not {tree}")
        bad = escaping_links(mirror, tree, tmp / "tree")
        if bad:
            raise Failed(f"refused: symlinks leave the pack: {', '.join(bad)}")
        if target.is_dir():
            return "present"
        (tmp / "tree").rename(target)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return "fetched"


def main():
    if len(sys.argv) > 2 or sys.argv[1:2] in (["-h"], ["--help"]):
        sys.exit(__doc__)
    env_home = os.environ.get("HOME", "")
    if not os.path.isabs(env_home) or Path(env_home).resolve() == Path("/"):
        sys.exit(f"factory-packs-fetch: HOME is {env_home!r}; it must be an absolute path other than /")
    home = Path(env_home) / ".software-factory"
    if home.is_symlink():
        sys.exit(f"factory-packs-fetch: {home} is a link to {home.resolve()}; run bin/factory-install first, which removes it")
    lock = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
    if not lock.is_file():
        lock = lock / ".software-factory" / "factory.lock"
    if not lock.is_file():
        sys.exit(f"factory-packs-fetch: no {lock}")
    wanted = pins(lock)
    if not wanted:
        print(f"no packs pinned in {lock}")
        return

    packs = home / "packs"
    packs.mkdir(parents=True, exist_ok=True)
    with open(packs / ".lock", "w") as held:
        fcntl.flock(held, fcntl.LOCK_EX)  # ponytail: one run at a time per machine; packs are fetched rarely
        for stale in packs.glob(".tmp-*"):  # left by a run that was killed
            shutil.rmtree(stale, ignore_errors=True)
        fetched, broken, failed = set(), {}, 0
        for name, pin in wanted.items():
            try:
                print(f"{fetch_pin(packs, name, pin, fetched, broken)} {name}@{pin['hash']}")
            except (Failed, OSError, subprocess.CalledProcessError) as e:
                failed += 1
                print(f"failed {name}: {e}")
    if failed:
        sys.exit(f"factory-packs-fetch: {failed} of {len(wanted)} packs failed; skills continue without them")


if __name__ == "__main__":
    main()
