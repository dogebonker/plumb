#!/usr/bin/env python3
"""Install one Plumb commit into the framework cache: ~/.plumb/framework/<sha>/.

    bin/plumb-install <ref> [--repo <Plumb checkout>]

The checkout is --repo, else framework_repo in ~/.plumb/user/config.yaml,
else the repository this script lives in. kit/, skills/ and hooks/ of <ref>, and
bin/ when it has one, are unpacked with git archive into a temporary folder and renamed into place, so a
cache folder is complete or absent. The last line printed is the install path.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

PARTS = ("kit", "skills", "hooks")  # a complete install; bin/ is added when the commit has it


def git(repo, *args, binary=False, may_fail=False):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=not binary, check=False)
    if r.returncode and may_fail:
        return None
    if r.returncode:
        err = r.stderr.decode(errors="replace") if binary else r.stderr
        sys.exit(f"plumb-install: git {' '.join(args)}: {err.strip()}")
    return r.stdout if binary else r.stdout.strip()


def complete(folder):
    return all((folder / part).is_dir() for part in PARTS)


def framework_repo(config):
    """framework_repo from the user layer's config.yaml; exits when the file has no readable value."""
    m = re.search(r"^framework_repo:[ \t]*(\S.*?)[ \t]*$", config.read_text(), re.MULTILINE)
    value = m and m.group(1)
    try:
        value = json.loads(value) if value and value.startswith('"') else value and value.strip("'")
    except ValueError:
        value = None
    if not value:
        sys.exit(f"plumb-install: {config} has no readable framework_repo; fix it or pass --repo")
    return os.path.expanduser(value)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("ref")
    parser.add_argument("--repo")
    args = parser.parse_args()

    env_home = os.environ.get("HOME", "")
    if not os.path.isabs(env_home) or Path(env_home).resolve() == Path("/"):
        sys.exit(f"plumb-install: HOME is {env_home!r}; it must be an absolute path other than /")
    home = Path(env_home) / ".plumb"
    config = home / "user" / "config.yaml"
    repo = os.path.expanduser(args.repo) if args.repo else None
    if not repo and not home.is_symlink() and config.is_file():
        repo = framework_repo(config)
    repo = Path(git(repo or Path(__file__).resolve().parent, "rev-parse", "--show-toplevel")).resolve()
    sha = git(repo, "rev-parse", "--verify", f"{args.ref}^{{commit}}")

    if home.is_symlink():
        target = home.resolve()
        if target.name != "kit" or not (target / "packs.lock.yaml").is_file():
            sys.exit(f"plumb-install: {home} is a link to {target}, which is not a Plumb kit/; move it yourself")
        home.unlink()  # the link only: its target is a Plumb checkout's kit/
        print(f"removed the old link {home} -> {target}; its target is untouched")

    dest = home / "framework" / sha
    if complete(dest):
        print(f"framework {sha[:12]} is already installed")
    else:
        dest.parent.mkdir(parents=True, exist_ok=True)
        tmp = Path(tempfile.mkdtemp(prefix=f".{sha[:12]}-", dir=dest.parent))
        parts = PARTS + (("bin",) if git(repo, "cat-file", "-e", f"{sha}:bin", may_fail=True) is not None else ())
        try:
            archive = git(repo, "archive", "--format=tar", sha, *parts, binary=True)
            subprocess.run(["tar", "-x", "-C", str(tmp)], input=archive, check=True)
            if complete(dest):  # another install finished meanwhile: never replace a complete one
                print(f"framework {sha[:12]} is already installed")
            else:
                if dest.exists():  # an incomplete earlier install, such as a hand install without hooks/
                    aside = Path(tempfile.mkdtemp(prefix=f".{sha[:12]}-old-", dir=dest.parent))
                    dest.rename(aside / "old")
                    shutil.rmtree(aside)
                tmp.rename(dest)
                print(f"installed framework {sha[:12]} from {repo}")
        except OSError:
            if not complete(dest):  # another install may have won the rename
                raise
            print(f"framework {sha[:12]} is already installed")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)

    if not config.exists():
        config.parent.mkdir(parents=True, exist_ok=True)
        config.write_text(f"framework_repo: {json.dumps(str(repo))}\n")
        print(f"wrote {config}")
    print(dest)


if __name__ == "__main__":
    main()
